{
  "name": "gereh",
  "version": "1.0.1",
  "description": "GEREH desktop rhinestone and textile vectorization platform.",
  "author": "GEREH",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts --host --port=8100",
    "build": "tsx script/build.ts",
    "build:client": "vite build",
    "start": "NODE_ENV=production node dist/index.cjs",
    "start:prod": "cross-env NODE_ENV=production HOST=0.0.0.0 PORT=8100 node dist/index.cjs",
    "check": "tsc",
    "smoke:web": "node script/web-smoke.cjs",
    "db:push": "drizzle-kit push",
    "desktop:dev": "cross-env DESKTOP_START_URL=http://127.0.0.1:8100 concurrently -k \"npm:dev\" \"wait-on tcp:8100 && electron .\"",
    "desktop:start": "npm run build && cross-env NODE_ENV=production electron .",
    "desktop:prepare": "electron-builder install-app-deps --arch=x64 && npx @electron/rebuild -f -w better-sqlite3 -v 33.4.11",
    "desktop:cleanup-portable": "node script/desktop-cleanup.cjs",
    "desktop:preflight": "node script/desktop-preflight.cjs",
    "desktop:build": "npm run desktop:prepare && npm run build && npm run desktop:preflight && electron-builder --win nsis",
    "desktop:release": "npm run desktop:build",
    "desktop:test-exe": "npm run desktop:prepare && npm run build && electron-builder --win nsis --publish never",
    "license:issuer": "electron desktop/license-issuer-main.cjs",
    "license:issuer:build": "electron-builder --win portable --config desktop/license-issuer-builder.json",
    "license:keygen": "node script/license-generator.cjs keygen",
    "license:sign": "node script/license-generator.cjs sign",
    "license:sign-request": "node script/license-generator.cjs sign-request",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "apk:init": "npx cap add android",
    "apk:sync": "npm run build:client && npx cap sync android",
    "apk:open": "npx cap open android",
    "apk:run": "npm run apk:sync && npx cap run android",
    "apk:doctor": "node script/apk-doctor.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "call-bind-apply-helpers": "^1.0.2",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "electron-updater": "^6.7.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "framer-motion": "^11.18.2",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.453.0",
    "memorystore": "^1.6.8",
    "multer": "^2.0.2",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.24.1",
    "opencv-wasm": "^4.3.0-10",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfjs-dist": "^5.4.624",
    "pdfkit": "^0.15.2",
    "pg": "^8.16.3",
    "potrace": "^2.1.8",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.0",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "serialport": "^13.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "svg-path-properties": "^2.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.20",
    "@replit/vite-plugin-cartographer": "^0.4.4",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.19.27",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.13.9",
    "@types/potrace": "^2.1.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sharp": "^0.31.1",
    "@types/svg-to-pdfkit": "*",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "wait-on": "^8.0.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.gereh.desktop",
    "afterPack": "desktop/scripts/after-pack-obfuscate.cjs",
    "afterSign": "desktop/scripts/after-sign.cjs",
    "productName": "GEREH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/prereqs",
        "to": "prereqs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "dist/**/*.py",
      "models/**/*",
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/serialport/**/*",
      "node_modules/potrace/**/*"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "publisherName": "GEREH",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "desktop/assets/icon.ico",
      "uninstallerIcon": "desktop/assets/icon.ico",
      "installerHeaderIcon": "desktop/assets/icon.ico"
    }
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.20.4"
    }
  }
}
