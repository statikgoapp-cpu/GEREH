NODE_ENV=production
HOST=0.0.0.0
PORT=8100
# Free beta: allow API access without a desktop license.
NP_LICENSE_ALLOWED=1
# Required: generate a long random value and keep it private.
JWT_SECRET=

# Optional: absolute path to Poppler bin directory (pdftoppm / pdfinfo)
# Example (Windows): C:\poppler\Library\bin
# Example (Linux): /usr/bin
POPPLER_PATH=

# Optional: enable/disable external ControlNet endpoint usage
CONTROLNET_API_BASE=http://127.0.0.1:7860
CONTROLNET_MODULE=canny
CONTROLNET_MODEL=
